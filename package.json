{
  "name": "open-webui-ai",
  "version": "1.0.0",
  "description": "内网大模型桌面客户端 - Electron + Vue 3",
  "main": "dist-electron/main.js",
  "author": "Open WebUI AI",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:electron && electron-builder --win portable",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "postinstall": "electron-builder install-app-deps || true",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cheerio": "^1.0.0",
    "iconv-lite": "^0.6.3",
    "marked": "^14.1.2",
    "node-fetch": "^2.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.5",
    "@types/node-fetch": "^2.6.11",
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "22.3.27",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue": "^3.5.11",
    "vue-tsc": "^2.1.6",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.openwebui.ai",
    "productName": "OpenWebUI AI",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-x64-portable.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-x64-portable.exe"
    }
  }
}
